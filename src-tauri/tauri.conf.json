{
  "identifier": "com.obsia.desktop",
  "build": {
    "beforeDevCommand": "cd ../src && npm run dev",
    "frontendDist": "../src/dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OBSIA",
        "width": 1400,
        "height": 900
      }
    ],
    "security": {
      "csp": "default-src 'self' data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' http://localhost:11434 https://api.openai.com https://api.anthropic.com https://openrouter.ai https://generativelanguage.googleapis.com ws://localhost:* wss://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "app",
      "dmg",
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "fs": {
      "scope": [
        "$APPDATA/**",
        "$HOME/**"
      ]
    },
    "shell": {
      "scope": {
        "allow": [
          "ollama",
          "ollama *"
        ]
      }
    },
    "http": {
      "scope": [
        "https://api.openai.com/**",
        "https://api.anthropic.com/**",
        "https://openrouter.ai/**",
        "https://generativelanguage.googleapis.com/**"
      ]
    }
  }
}
